# local: 数据只保存在浏览器 localStorage
# cloud: 通过腾讯云 CloudBase 云函数读写文档型数据库（默认）
VITE_DATA_MODE=cloud

# 云函数访问地址。留空时按 VITE_TCB_ENV_ID 自动拼出
# https://<envId>.service.tcloudbase.com<VITE_TCB_SERVICE_PATH>
VITE_API_URL=

# CloudBase 环境 ID，例如 menu-data-1a2b3c
VITE_TCB_ENV_ID=

# 云函数 HTTP 访问路径，默认 /menuApi
VITE_TCB_SERVICE_PATH=/menuApi

# 静态托管的部署路径，默认 /
VITE_BASE_PATH=/

# 本地开发时前端默认使用的访问密钥（需要和启动 dev server 时的 APP_ACCESS_KEY 一致）
VITE_DEV_APP_KEY=local-dev-key
